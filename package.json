{
  "name": "@longline/web",
  "version": "0.3.3",
  "description": "The Longline Labs website shell shared by coifish.com, reelminders.com and packetskipper.com: design tokens, the header with the app switcher, the footer, the light/dark switch and a page layout. One family, one accent per app.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "src",
    "logos",
    "tokens",
    "*.css",
    "*.json",
    "*.md",
    "sites.json",
    "illustration"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./shell.css": "./shell.css",
    "./tokens.json": "./tokens/tokens.json",
    "./apps.json": "./apps.json",
    "./logos/*": "./logos/*",
    "./illustration/*": "./illustration/*"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "npm run check:tokens && npm run check:contrast && npm run check:sites && npm run check:types",
    "check:sites": "node scripts/check-sites.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
