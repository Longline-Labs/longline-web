{
  "name": "Longline Labs web tokens",
  "version": "0.1.0",
  "source": "Palette, type and spacing values are Harbor's (apps/harbor, @longline/harbor 0.2.0 tokens.json), the design language the three apps already share. Change a value here, run `npm run build:tokens`, and the CSS follows. Harbor's names are kept so a page written against Harbor reads the same values.",
  "modes": ["light", "dark"],
  "base": {
    "light": {
      "paper": "#f6f3ec",
      "paper-raised": "#fdfbf7",
      "paper-sunken": "#ede8dd",
      "hairline": "#d9d2c3",
      "hairline-strong": "#8c8470",
      "ink": "#1b2a33",
      "ink-muted": "#5b6770",
      "ink-faint": "#8a939a",
      "sea": "#1d4b5a",
      "on-sea": "#f6f3ec",
      "sea-tint": "#dfe9ec",
      "mark-ink": "#1d4b5a",
      "koi": "#d9643a",
      "koi-deep": "#b24a24",
      "brass": "#c6912c",
      "brass-deep": "#8a5f10",
      "kelp": "#2e8a68",
      "kelp-deep": "#1f6b50",
      "shadow-float": "0 8px 24px rgba(27, 42, 51, 0.14)"
    },
    "dark": {
      "paper": "#13232a",
      "paper-raised": "#1a2d35",
      "paper-sunken": "#0e1a1f",
      "hairline": "#2b3f47",
      "hairline-strong": "#5d7983",
      "ink": "#e9e4d8",
      "ink-muted": "#a7b0b3",
      "ink-faint": "#6d7b80",
      "sea": "#7fb4c4",
      "on-sea": "#13232a",
      "sea-tint": "#1e3a44",
      "mark-ink": "#e9e4d8",
      "koi": "#e8865c",
      "koi-deep": "#f0a07a",
      "brass": "#d9a94a",
      "brass-deep": "#e4b85e",
      "kelp": "#4fb08a",
      "kelp-deep": "#67c39d",
      "shadow-float": "0 8px 24px rgba(0, 0, 0, 0.5)"
    }
  },
  "status": {
    "_note": "Fixed across every app and never repainted by an accent. ok = current / done (a green-teal), warn = expiring soon / due this week (amber), danger = expired / overdue (red), info = pending review (the family teal), as coifish.com uses them today.",
    "light": {
      "status-ok": "#1e6f7a",
      "status-warn": "#8a5f10",
      "status-danger": "#a63a2e",
      "status-info": "#1d4b5a",
      "status-ok-tint": "#dcedef",
      "status-warn-tint": "#f5ecd6",
      "status-danger-tint": "#f6e2de",
      "status-info-tint": "#dfe9ec"
    },
    "dark": {
      "status-ok": "#6dc4cf",
      "status-warn": "#e4b85e",
      "status-danger": "#ef8b7d",
      "status-info": "#7fb4c4",
      "status-ok-tint": "#173a40",
      "status-warn-tint": "#3b3016",
      "status-danger-tint": "#43231f",
      "status-info-tint": "#1e3a44"
    }
  },
  "accents": {
    "_note": "One accent per app, chosen in apps.json. Each has four roles: `accent` for the top-bar stripe and the app's tile in the switcher (a graphic: 3:1 against the page), `text` for the active nav item and link hover (text: 4.5:1 against paper and paper-raised), `fill` for the primary call-to-action button and `on-fill` for its label (4.5:1). scripts/check-contrast.mjs fails the build if any role falls short in either mode. Where a brand colour is too light for a role (brass by day), the role takes Harbor's `-deep` value of the same colour.",
    "teal": {
      "label": "Teal (the family's sea)",
      "light": { "accent": "#1d4b5a", "text": "#1d4b5a", "fill": "#1d4b5a", "on-fill": "#f6f3ec" },
      "dark": { "accent": "#7fb4c4", "text": "#7fb4c4", "fill": "#7fb4c4", "on-fill": "#13232a" }
    },
    "koi": {
      "label": "Koi (Coifish's rust, as drawn in its mark)",
      "light": { "accent": "#d9643a", "text": "#b24a24", "fill": "#b24a24", "on-fill": "#f6f3ec" },
      "dark": { "accent": "#e8865c", "text": "#f0a07a", "fill": "#e8865c", "on-fill": "#13232a" }
    },
    "brass": {
      "label": "Brass (ReelMinder's gold)",
      "light": { "accent": "#8a5f10", "text": "#8a5f10", "fill": "#8a5f10", "on-fill": "#f6f3ec" },
      "dark": { "accent": "#d9a94a", "text": "#e4b85e", "fill": "#d9a94a", "on-fill": "#13232a" }
    },
    "kelp": {
      "label": "Kelp (PacketSkipper's green)",
      "light": { "accent": "#2e8a68", "text": "#1f6b50", "fill": "#1f6b50", "on-fill": "#f6f3ec" },
      "dark": { "accent": "#4fb08a", "text": "#67c39d", "fill": "#4fb08a", "on-fill": "#13232a" }
    }
  },
  "font": {
    "display": { "family": "Fraunces", "nextVariable": "--font-fraunces", "fallback": "\"Iowan Old Style\", Georgia, serif" },
    "sans": { "family": "Instrument Sans", "nextVariable": "--font-instrument", "fallback": "\"Helvetica Neue\", Arial, sans-serif" },
    "mono": { "family": "IBM Plex Mono", "nextVariable": "--font-plex-mono", "fallback": "\"SF Mono\", Menlo, monospace" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px" },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "round": "999px" },
  "layout": { "header-height": "64px", "content-width": "1100px", "gutter": "24px", "gutter-phone": "16px" }
}
