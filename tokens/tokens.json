{
  "name": "Longline Labs web tokens",
  "version": "0.1.0",
  "source": "Palette, type and spacing values are Harbor's (apps/harbor, @longline/harbor 0.2.0 tokens.json), the design language the three apps already share. Change a value here, run `npm run build:tokens`, and the CSS follows. Harbor's names are kept so a page written against Harbor reads the same values.",
  "modes": [
    "light",
    "dark"
  ],
  "base": {
    "light": {
      "paper": "#f6f3ec",
      "paper-raised": "#fdfbf7",
      "paper-sunken": "#ede8dd",
      "hairline": "#d9d2c3",
      "hairline-strong": "#8c8470",
      "ink": "#1b2a33",
      "ink-muted": "#5b6770",
      "ink-faint": "#8a939a",
      "sea": "#1d4b5a",
      "on-sea": "#f6f3ec",
      "sea-tint": "#dfe9ec",
      "mark-ink": "#1d4b5a",
      "koi": "#d9643a",
      "koi-deep": "#b24a24",
      "brass": "#c6912c",
      "brass-deep": "#8a5f10",
      "kelp": "#2e8a68",
      "kelp-deep": "#1f6b50",
      "shadow-float": "0 8px 24px rgba(27, 42, 51, 0.14)"
    },
    "dark": {
      "paper": "#13232a",
      "paper-raised": "#1a2d35",
      "paper-sunken": "#0e1a1f",
      "hairline": "#2b3f47",
      "hairline-strong": "#5d7983",
      "ink": "#e9e4d8",
      "ink-muted": "#a7b0b3",
      "ink-faint": "#6d7b80",
      "sea": "#7fb4c4",
      "on-sea": "#13232a",
      "sea-tint": "#1e3a44",
      "mark-ink": "#e9e4d8",
      "koi": "#e8865c",
      "koi-deep": "#f0a07a",
      "brass": "#d9a94a",
      "brass-deep": "#e4b85e",
      "kelp": "#4fb08a",
      "kelp-deep": "#67c39d",
      "shadow-float": "0 8px 24px rgba(0, 0, 0, 0.5)"
    }
  },
  "status": {
    "_note": "Fixed across every app and never repainted by an accent. ok = current / done (a green-teal), warn = expiring soon / due this week (amber), danger = expired / overdue (red), info = pending review (the family teal), as coifish.com uses them today.",
    "light": {
      "status-ok": "#1e6f7a",
      "status-warn": "#8a5f10",
      "status-danger": "#a63a2e",
      "status-info": "#1d4b5a",
      "status-ok-tint": "#dcedef",
      "status-warn-tint": "#f5ecd6",
      "status-danger-tint": "#f6e2de",
      "status-info-tint": "#dfe9ec"
    },
    "dark": {
      "status-ok": "#6dc4cf",
      "status-warn": "#e4b85e",
      "status-danger": "#ef8b7d",
      "status-info": "#7fb4c4",
      "status-ok-tint": "#173a40",
      "status-warn-tint": "#3b3016",
      "status-danger-tint": "#43231f",
      "status-info-tint": "#1e3a44"
    }
  },
  "accents": {
    "_note": "One accent per app, chosen in apps.json. UI roles: `accent` for the top-bar stripe and the app's switcher tile (a graphic: 3:1 against the page), `text` for the active nav item and link hover (4.5:1 against paper and paper-raised), `fill` for the primary button and `on-fill` for its label (4.5:1). Brand roles from the approved package's palette.json: `mark` is the accent stroke inside the app's mark (the first three keep their day colour at night; the newer three take the night value), `illustration` is the app's dot in the six-colour longline (the night value for all). scripts/check-contrast.mjs fails the build if any role falls short in either mode. Where a brand colour is too light for a role by day (brass; azure on a button), that role takes a deeper value of the same hue.",
    "teal": {
      "label": "Teal (the family's sea; no app's own)",
      "light": {
        "accent": "#1d4b5a",
        "text": "#1d4b5a",
        "fill": "#1d4b5a",
        "on-fill": "#f6f3ec",
        "mark": "#1d4b5a",
        "illustration": "#1d4b5a"
      },
      "dark": {
        "accent": "#7fb4c4",
        "text": "#7fb4c4",
        "fill": "#7fb4c4",
        "on-fill": "#13232a",
        "mark": "#e9e4d8",
        "illustration": "#e9e4d8"
      }
    },
    "koi": {
      "label": "Koi (Coifish's rust)",
      "light": {
        "accent": "#d9643a",
        "text": "#b24a24",
        "fill": "#b24a24",
        "on-fill": "#f6f3ec",
        "mark": "#d9643a",
        "illustration": "#d9643a"
      },
      "dark": {
        "accent": "#e8865c",
        "text": "#f0a07a",
        "fill": "#e8865c",
        "on-fill": "#13232a",
        "mark": "#d9643a",
        "illustration": "#e8865c"
      }
    },
    "brass": {
      "label": "Brass (ReelMinder's gold)",
      "light": {
        "accent": "#8a5f10",
        "text": "#8a5f10",
        "fill": "#8a5f10",
        "on-fill": "#f6f3ec",
        "mark": "#c6912c",
        "illustration": "#c6912c"
      },
      "dark": {
        "accent": "#d9a94a",
        "text": "#e4b85e",
        "fill": "#d9a94a",
        "on-fill": "#13232a",
        "mark": "#c6912c",
        "illustration": "#d9a94a"
      }
    },
    "kelp": {
      "label": "Kelp (PacketSkipper's green)",
      "light": {
        "accent": "#2e8a68",
        "text": "#1f6b50",
        "fill": "#1f6b50",
        "on-fill": "#f6f3ec",
        "mark": "#2e8a68",
        "illustration": "#2e8a68"
      },
      "dark": {
        "accent": "#4fb08a",
        "text": "#67c39d",
        "fill": "#4fb08a",
        "on-fill": "#13232a",
        "mark": "#2e8a68",
        "illustration": "#4fb08a"
      }
    },
    "cobalt": {
      "label": "Cobalt (BallastBook's blue)",
      "light": {
        "accent": "#4b63a6",
        "text": "#4b63a6",
        "fill": "#4b63a6",
        "on-fill": "#f6f3ec",
        "mark": "#4b63a6",
        "illustration": "#4b63a6"
      },
      "dark": {
        "accent": "#8aa0e0",
        "text": "#8aa0e0",
        "fill": "#8aa0e0",
        "on-fill": "#13232a",
        "mark": "#8aa0e0",
        "illustration": "#8aa0e0"
      }
    },
    "plum": {
      "label": "Plum (ShipShape's purple)",
      "light": {
        "accent": "#8c4f86",
        "text": "#8c4f86",
        "fill": "#8c4f86",
        "on-fill": "#f6f3ec",
        "mark": "#8c4f86",
        "illustration": "#8c4f86"
      },
      "dark": {
        "accent": "#c993c2",
        "text": "#c993c2",
        "fill": "#c993c2",
        "on-fill": "#13232a",
        "mark": "#c993c2",
        "illustration": "#c993c2"
      }
    },
    "azure": {
      "label": "Azure (Aboveboard's blue). #3786b0 reads 3.7:1 on paper, so text and the button take #2d6e93 by day, a deeper step of the same hue not in the brand package.",
      "light": {
        "accent": "#3786b0",
        "text": "#2d6e93",
        "fill": "#2d6e93",
        "on-fill": "#f6f3ec",
        "mark": "#3786b0",
        "illustration": "#3786b0"
      },
      "dark": {
        "accent": "#79b9d8",
        "text": "#79b9d8",
        "fill": "#79b9d8",
        "on-fill": "#13232a",
        "mark": "#79b9d8",
        "illustration": "#79b9d8"
      }
    }
  },
  "font": {
    "display": {
      "family": "Fraunces",
      "nextVariable": "--font-fraunces",
      "fallback": "\"Iowan Old Style\", Georgia, serif"
    },
    "sans": {
      "family": "Instrument Sans",
      "nextVariable": "--font-instrument",
      "fallback": "\"Helvetica Neue\", Arial, sans-serif"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "nextVariable": "--font-plex-mono",
      "fallback": "\"SF Mono\", Menlo, monospace"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "round": "999px"
  },
  "layout": {
    "_note": "The page frame every site shares. Phone values apply under 768px.",
    "header-height": "64px",
    "content-width": "1100px",
    "gutter": "24px",
    "section-gap": "40px",
    "hero-pad-top": "48px",
    "hero-pad-bottom": "64px",
    "hero-columns": "minmax(0, 1fr) minmax(0, 1.15fr)",
    "hero-gap": "48px",
    "pricing-columns": "repeat(2, minmax(0, 1fr))",
    "pricing-gap": "16px",
    "phone": {
      "gutter": "16px",
      "section-gap": "32px",
      "hero-pad-top": "32px",
      "hero-pad-bottom": "40px",
      "hero-columns": "minmax(0, 1fr)",
      "hero-gap": "32px",
      "pricing-columns": "minmax(0, 1fr)"
    }
  },
  "type": {
    "_note": "The one type scale every site uses: family, size and line height in px, weight, tracking. The phone values apply under 768px. Sites take these through the ll-* classes in shell.css (or the --ll-<role>-* variables) and define none of their own.",
    "display-xl": {
      "family": "display",
      "size": 44,
      "line": 50,
      "weight": 500,
      "tracking": "-0.01em",
      "phone": {
        "size": 32,
        "line": 38
      }
    },
    "display-md": {
      "family": "display",
      "size": 28,
      "line": 34,
      "weight": 500,
      "tracking": "-0.005em",
      "phone": {
        "size": 24,
        "line": 30
      }
    },
    "title": {
      "family": "sans",
      "size": 20,
      "line": 28,
      "weight": 600
    },
    "heading": {
      "family": "sans",
      "size": 16,
      "line": 24,
      "weight": 600
    },
    "body-lg": {
      "family": "sans",
      "size": 17,
      "line": 26,
      "weight": 400
    },
    "body": {
      "family": "sans",
      "size": 15,
      "line": 22,
      "weight": 400
    },
    "body-sm": {
      "family": "sans",
      "size": 13,
      "line": 18,
      "weight": 400
    },
    "label": {
      "family": "sans",
      "size": 12,
      "line": 16,
      "weight": 600,
      "tracking": "0.04em",
      "transform": "uppercase"
    },
    "numeral": {
      "family": "mono",
      "size": 15,
      "line": 22,
      "weight": 500
    }
  }
}
